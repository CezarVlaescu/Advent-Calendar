# Variabile PUBLICE Vite (pot fi citite în browser)
VITE_ADVENT_YEAR=2026
VITE_PERSON_NAME=iubirea mea
VITE_FROM_NAME=cu drag, de la mine

# Doar pentru testul vizual LOCAL: creează .env.demo.local cu VITE_LOCAL_DEMO=true
# NU seta VITE_LOCAL_DEMO=true pe Netlify, altfel surprizele nu vor fi sincronizate!

# Pentru Netlify Functions setează aceste două în Netlify → Environment variables:
# ADVENT_ADMIN_PASSWORD = parola unică, lungă, aleasă de tine (min. 16 caractere)
# ADVENT_SESSION_SECRET = șir aleator, min. 32 caractere
# Opțional: ADVENT_YEAR=2026 (serverul folosește implicit 2026)
# IMPORTANT: niciuna dintre variabilele secrete NU începe cu VITE_ .
